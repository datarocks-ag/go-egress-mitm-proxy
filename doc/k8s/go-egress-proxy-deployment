apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-app
spec:
  # selector and template.metadata.labels are required for apps/v1 Deployments
  # and must match; without them kubectl apply fails validation.
  selector:
    matchLabels:
      app: my-app
  template:
    metadata:
      labels:
        app: my-app
    spec:
      # NOTE: environment-variable proxying is advisory, not a gate. It is honoured
      # only by clients that choose to read it; a static binary, a hardcoded
      # http.Transport or anything deliberately evading it reaches the network
      # directly. If egress must be enforced rather than encouraged, pair this with
      # a NetworkPolicy or an init-container iptables REDIRECT so the proxy is the
      # only route out of the pod.
      # Must exceed PROXY_PRESTOP_GRACE plus the 30s drain budget, or the kubelet
      # SIGKILLs the proxy mid-drain and the graceful shutdown is wasted. Sized
      # for the 10s default (10 + 30 = 40, with headroom); raise this by the same
      # amount if you raise PROXY_PRESTOP_GRACE.
      terminationGracePeriodSeconds: 45
      containers:
        # 1. Your Application
        - name: app
          image: my-app-image:latest
          env:
            # Both schemes, and both cases. Every proxy-aware client selects by
            # REQUEST scheme, so HTTPS_PROXY alone leaves all cleartext egress
            # going direct -- no ACL evaluation, no 403, no blocked-log entry and
            # no proxy_traffic_total series for it. curl and several libraries
            # read only the lowercase spellings.
            - name: HTTP_PROXY
              value: "http://localhost:8080"
            - name: HTTPS_PROXY
              value: "http://localhost:8080"
            - name: http_proxy
              value: "http://localhost:8080"
            - name: https_proxy
              value: "http://localhost:8080"
            # Keep in-cluster and link-local traffic off the proxy. Adjust the
            # CIDR to your cluster's service/pod ranges.
            - name: NO_PROXY
              value: "localhost,127.0.0.1,.svc,.cluster.local,10.0.0.0/8,169.254.169.254"
            - name: no_proxy
              value: "localhost,127.0.0.1,.svc,.cluster.local,10.0.0.0/8,169.254.169.254"
            - name: SSL_CERT_FILE # Point app to the Proxy CA
              value: "/etc/ssl/certs/proxy-ca.crt"
          volumeMounts:
            - name: ca-certs
              mountPath: /etc/ssl/certs/proxy-ca.crt
              subPath: ca.crt

        # 2. The MITM Proxy Sidecar
        - name: mitm-proxy
          image: my-registry/mitm-proxy:latest
          ports:
            - containerPort: 8080
            - containerPort: 9090
          # /readyz reports 503 until the proxy port is bound, and again as soon
          # as shutdown begins, so it is safe to gate traffic on. /healthz stays
          # independent on purpose: failing it during a drain would have the
          # kubelet kill the pod mid-drain.
          readinessProbe:
            httpGet:
              path: /readyz
              port: 9090
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: 9090
            periodSeconds: 10
          volumeMounts:
            - name: config
              # The image sets WORKDIR /app and CONFIG_PATH=/app/config.yaml.
              # Mounting at /root/config.yaml left the container with no config
              # at the path it reads, so it exited 1 on start.
              mountPath: /app/config.yaml
              subPath: config.yaml
            - name: ca-certs
              mountPath: /etc/proxy/certs

      volumes:
        - name: config
          configMap:
            name: proxy-config
        - name: ca-certs
          secret:
            secretName: proxy-tls-secret # Contains ca.crt and ca.key